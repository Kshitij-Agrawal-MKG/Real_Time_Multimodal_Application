# Voice Assistant — credentials
# Copy to .env and fill in your keys. Never commit .env to version control.

# Vosk ASR — local model, no API key needed
# Download a model from https://alphacephei.com/vosk/models
# Extract it and set the path below (or leave blank to use ./vosk_model/)
VOSK_MODEL_PATH=./vosk_model

# Gemini LLM
GEMINI_API_KEY=your_gemini_key_here

# AWS Polly TTS
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
